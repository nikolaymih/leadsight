# Copy to deploy/.env. Read by `docker compose --env-file deploy/.env -f deploy/compose.yml`
# (for ${...} substitution) AND passed to the API container as its environment.
# Never commit deploy/.env.

# Public hostname; Caddy gets a certificate for it and every URL is derived from it.
DOMAIN=leads.example.com

# Postgres password for the bundled database (user/db are both `leadsight`).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Better Auth: `openssl rand -base64 32`; must be at least 32 characters.
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters

# LLM providers (at least one). Caps are tokens per UTC day per key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DAILY_TOKENS=200000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_TOKENS=

# Web search (primary discovery for Reddit, LinkedIn and X). Either key enables web_search
# sources; with both, queries rotate between them. Without either the app still starts and
# web_search sources report "not configured". Monthly caps: 90% = back off, 100% = stop.
EXA_API_KEY=
TAVILY_API_KEY=
# Exa counts requests, Tavily counts credits (1 per basic search).
EXA_MONTHLY_SEARCHES=1000
TAVILY_MONTHLY_CREDITS=1000
# Reddit Data API — optional; our request was denied 2026-09-16 (docs/reddit-access.md). Leave empty to disable reddit_* sources.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=leadsight/0.1 by <your-reddit-username>

# Email: password resets, invitations, lead digests. Logged (not sent) when SMTP_URL is empty.
SMTP_URL=
SMTP_FROM=LeadSight <no-reply@example.com>

# Optional "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Scheduler (defaults shown).
SCHEDULER_ENABLED=true
SCHEDULER_CRON=*/5 * * * *
LOG_LEVEL=info
