# Copy to deploy/.env. Read by `docker compose --env-file deploy/.env -f deploy/compose.yml`
# (for ${...} substitution) AND passed to the API container as its environment.
# Never commit deploy/.env.

# Public hostname; Caddy gets a certificate for it and every URL is derived from it.
DOMAIN=leads.example.com

# Postgres password for the bundled database (user/db are both `leadsight`).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Better Auth: `openssl rand -base64 32`; must be at least 32 characters.
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters

# LLM providers (at least one). Caps are tokens per UTC day per key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DAILY_TOKENS=200000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_TOKENS=

# Google Programmable Search (primary discovery source for Reddit, LinkedIn and X).
# Create a search engine at programmablesearchengine.google.com ("search the entire web"),
# an API key in Google Cloud (Custom Search API). Free tier: 100 queries/day.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_DAILY_QUERIES=100
# Reddit Data API — optional; approvals are rare (docs/reddit-access.md). Leave empty to disable reddit_* sources.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=leadsight/0.1 by <your-reddit-username>

# Email: password resets, invitations, lead digests. Logged (not sent) when SMTP_URL is empty.
SMTP_URL=
SMTP_FROM=LeadSight <no-reply@example.com>

# Optional "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Scheduler (defaults shown).
SCHEDULER_ENABLED=true
SCHEDULER_CRON=*/5 * * * *
LOG_LEVEL=info
