DATABASE_URL=postgres://leadsight:leadsight@localhost:5432/leadsight
# Generate with `openssl rand -base64 32`. Must be >= 32 characters in production.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001
# Optional API settings (defaults shown)
# PORT=3001
# HOST=0.0.0.0
# LOG_LEVEL=info
# SCHEDULER_ENABLED=true
# SCHEDULER_CRON=*/5 * * * *
GROQ_API_KEY=
GEMINI_API_KEY=
# Web search (primary discovery for Reddit, LinkedIn and X). Either key enables web_search
# sources; with both, queries rotate between them. Without either the app still starts and
# web_search sources report "not configured". Monthly caps: 90% = back off, 100% = stop.
EXA_API_KEY=
TAVILY_API_KEY=
# Exa counts requests, Tavily counts credits (1 per basic search).
EXA_MONTHLY_SEARCHES=1000
TAVILY_MONTHLY_CREDITS=1000
# Reddit Data API — optional; our request was denied 2026-09-16 (docs/reddit-access.md). Leave empty to disable reddit_* sources.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=leadsight/0.1 by <your-reddit-username>
# Email: password resets, invitations, lead digests. Logged (not sent) when SMTP_URL is empty.
SMTP_URL=
SMTP_FROM=LeadSight <no-reply@localhost>
WEB_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DAILY_TOKENS=200000
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_TOKENS=
NEXT_PUBLIC_API_URL=http://localhost:3001
