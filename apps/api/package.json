    "@leadsight/contract": "workspace:*",
    "@leadsight/core": "workspace:*",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@orpc/client": "^1.15.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
